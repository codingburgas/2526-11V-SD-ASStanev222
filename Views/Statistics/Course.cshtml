@using ProjectLMS.Models.ViewModels
@{
    ViewData["Title"] = "Course Statistics";
    var course = ViewBag.Course as CourseViewModel;
    var averageGrade = (double?)ViewBag.AverageGrade ?? 0.0;
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Statistics" asp-action="Index">Statistics</a></li>
                <li class="breadcrumb-item active">Course Statistics</li>
            </ol>
        </nav>

        @if (course != null)
        {
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h1 class="h4 mb-0">@course.Title</h1>
                    <span class="badge bg-primary">Average Grade: @averageGrade.ToString("F1")</span>
                </div>
                <div class="card-body">
                    <p class="lead">@course.Description</p>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Enrolled Students:</strong> @course.EnrolledStudentCount
                        </div>
                        <div class="col-md-6">
                            <strong>Lessons:</strong> @course.LessonCount
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Created On:</strong> @course.CreatedAt.ToString("MMMM dd, yyyy")
                        </div>
                        <div class="col-md-6">
                            <strong>Created By:</strong> @course.CreatedByUserId
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="btn btn-primary">Back to Course</a>
                        <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <h4 class="alert-heading">Course not found</h4>
                <p>The requested course statistics could not be loaded.</p>
                <a asp-controller="Statistics" asp-action="Index" class="btn btn-secondary">Back to Statistics</a>
            </div>
        }
    </div>
</div>
